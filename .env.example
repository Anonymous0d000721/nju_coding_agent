NJU_AGENT_API_FORMAT=openai-chat
NJU_AGENT_API_KEY=
NJU_AGENT_BASE_URL=https://api.openai.com/v1
NJU_AGENT_MODEL=
NJU_AGENT_THINKING_LEVEL=medium
# Tool preview head lines shown in TUI (default: 8).
NJU_AGENT_TOOL_PREVIEW_LINES=8
# JSON mapping; null disables a level.
NJU_AGENT_THINKING_LEVEL_MAP=
# reasoning_effort, anthropic-adaptive, or anthropic-budget
NJU_AGENT_THINKING_FORMAT=
# Run deadline in milliseconds (default 600000, range 1-1800000).
NJU_AGENT_MAX_DURATION_MS=600000
# Maximum independent tools running concurrently (default 4, range 1-8).
NJU_AGENT_MAX_TOOL_CONCURRENCY=4
# Optional JSON array. Servers start only when explicitly configured.
# NJU_AGENT_MCP_SERVERS=[{"name":"demo","command":"node","args":["server.js"]}]
# Default per-request MCP timeout: 30000 ms, range 1-300000.
NJU_AGENT_MCP_TIMEOUT_MS=30000
